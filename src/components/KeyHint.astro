---
/**
 * @file src/components/KeyHint.astro
 * @description Tecla de atajo legible. `kbd` con las teclas separadas, alimentado
 * desde `SHORTCUTS` para que lo que se muestra sea lo que se registra.
 */
interface Props {
  /** Combinación en notación de `SHORTCUTS`: `mod+k`, `escape`, `mod+shift+b`. */
  combo: string;
}

const { combo } = Astro.props;

// `mod` se resuelve por CSS (`meta` en macOS, `ctrl`/`⌘` visual) y aquí se pinta
// el literal neutro: la app no hace detección de plataforma en el servidor.
const keys = combo
  .split('+')
  .map((part) => ({ mod: '⌘/Ctrl', escape: 'Esc', comma: ',' , shift: '⇧', k: 'K', b: 'B' })[part] ?? part.toUpperCase());
---

<kbd class="inline-flex items-center gap-0.5 rounded border border-line bg-elevated px-1.5 text-code text-ink-muted">
  {keys.join(' + ')}
</kbd>
