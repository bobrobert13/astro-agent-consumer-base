---
/**
 * @file src/components/TopBar.astro
 * @description Barra superior con título de vista y slot de acciones.
 */
interface Props {
  title: string;
  /** Subtítulo opaco bajo el título (nombre del agente, modelo activo…). */
  subtitle?: string | undefined;
}

const { title, subtitle } = Astro.props;
---

<header class="flex items-center gap-3 border-b border-line bg-surface px-4 py-2.5">
  <div class="min-w-0 flex-1">
    <h1 class="truncate text-sm font-semibold">{title}</h1>
    {subtitle !== undefined && subtitle !== '' && (
      <p class="truncate text-xs text-ink-muted">{subtitle}</p>
    )}
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <slot />
  </div>
</header>
