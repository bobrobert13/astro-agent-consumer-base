---
/**
 * @file src/pages/agents/index.astro
 * @description Catálogo de agentes, **renderizado en el servidor**.
 *
 * Nótese lo que NO hay aquí: ni isla, ni `fetch` desde el navegador, ni caché.
 * La página corre en el proceso Node, así que llama directo al handler del slice.
 * Es la vía más barata para una vista que no necesita interactividad, y es el
 * contrapeso deliberado a "todo lo visible es una isla".
 *
 * Se prerenderiza (`prerender = true`) solo en el sentido de que el shell es
 * estático; con `output: 'server'` y datos por-request, se deja bajo demanda.
 */
import AppLayout from '@layouts/AppLayout.astro';
import PageTitle from '@components/PageTitle.astro';
import Panel from '@components/Panel.astro';
import Badge from '@components/Badge.astro';
import EmptyState from '@components/EmptyState.astro';
import ButtonLink from '@components/ButtonLink.astro';
import Icon from '@components/Icon.astro';
import { listAgents } from '@domains/agent-registry/server';
import { routes } from '@config/routes';

const result = await listAgents();
const agents = result.ok ? result.data : [];
const failure = result.ok ? undefined : result.error.message;
---

<AppLayout title="Agentes" active="agents">
  <div class="mx-auto h-full max-w-3xl overflow-y-auto px-6 py-8">
    <PageTitle title="Agentes disponibles" description={failure ?? 'Selecciona uno para abrir una conversación.'} />

    {agents.length === 0 ? (
      <EmptyState
        title="No hay agentes alcanzables"
        description={failure ?? 'El backend respondió un catálogo vacío. ¿Está levantado MASTRA_URL?'}
        icon="agents"
      >
        <ButtonLink href={routes.chat()}>Ir al chat de todas formas</ButtonLink>
      </EmptyState>
    ) : (
      <ul class="grid gap-3 sm:grid-cols-2">
        {agents.map((agent) => (
          <li>
            <Panel pad="sm" class="h-full">
              <div class="flex items-start gap-2">
                <Icon name="agents" class="mt-0.5 size-4 text-ink-muted" />
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-medium">{agent.name}</p>
                  <p class="mt-0.5 line-clamp-2 text-xs text-ink-muted">{agent.description}</p>
                  <code class="mt-1 block truncate font-mono text-[0.6875rem] text-ink-muted">{agent.id}</code>
                </div>
              </div>
              <div class="mt-3 flex items-center gap-2">
                <ButtonLink href={routes.chat()} size="sm" variant="primary">Abrir chat</ButtonLink>
                <ButtonLink href={routes.agent(agent.id)} size="sm" variant="ghost">Ficha</ButtonLink>
                <Badge tone="neutral">{agent.id === 'research-agent' ? 'default' : 'agente'}</Badge>
              </div>
            </Panel>
          </li>
        ))}
      </ul>
    )}
  </div>
</AppLayout>
