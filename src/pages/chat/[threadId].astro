---
/**
 * @file src/pages/chat/[threadId].astro
 * @description Ruta de conversación. La URL es el contrato: cambiar de hilo es
 * navegar, no emitir un evento ni mutar un store.
 *
 * `output: 'server'` hace que esta página se resuelva bajo demanda (no se
 * prerenderiza), que es lo que quiere decir "SPA por defecto con servidor
 * propio": el shell llega por el router de Astro y la isla hace de BFF.
 */
import AppLayout from '@layouts/AppLayout.astro';
import { Badge } from '@components/ui/badge';
import IslandFallback from '@components/IslandFallback.astro';
import { ChatIsland } from '@domains/agent-chat';
import { NEW_THREAD_ID } from '@config/app';

const threadId = Astro.params.threadId ?? NEW_THREAD_ID;
const isNew = threadId === NEW_THREAD_ID;
// El agente activo viaja en la URL, no en un store: es lo que hace que un enlace
// a una conversación sea compartible y de que "cambiar de agente" sea navegar.
const agentId = Astro.url.searchParams.get('agente') ?? 'research-agent';
---

<AppLayout title={isNew ? 'Hilo nuevo' : `Hilo ${threadId}`} active="chat" description="Conversación con el agente." subtitle={agentId}>
  <template #actions>
    <Badge variant="secondary">/chat/{threadId}</Badge>
  </template>

  <div class="h-full">
    <ChatIsland client:only="vue" transition:persist thread-id={threadId} agent-id={agentId}>
      <IslandFallback slot="fallback" lines={4} height="h-full" />
    </ChatIsland>
  </div>
</AppLayout>
