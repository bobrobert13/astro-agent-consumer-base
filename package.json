{
  "name": "astro-agent-consumer",
  "version": "0.0.1",
  "description": "Boilerplate Vue 3 + Astro para sistemas que consumen agentes de IA (BFF propio, streaming SSE y shell Electron).",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "astro dev",
    "dev:bg": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "build": "astro sync && astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "check": "astro sync && astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:relay": "npm run build && node scripts/verify-relay.mjs",
    "transport:mock": "node scripts/toggle-transport.mjs mock",
    "transport:mastra": "node scripts/toggle-transport.mjs mastra",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:all": "npm run build && electron-builder --linux --win --mac",
    "electron:rebuild": "electron-builder install-app-deps",
    "verify:electron": "npm run build && electron scripts/electron-smoke.mjs",
    "all": "npm run lint && npm run check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "author": "Trebor <dev@trebor.local>",
  "homepage": "https://PLACEHOLDER.example/astro-agent-consumer",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/node": "^11.1.5",
    "@astrojs/vue": "^7.0.2",
    "@lucide/vue": "^1.46.0",
    "@mastra/client-js": "^1.46.0",
    "@pinia/colada": "^1.4.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/shared": "^14.4.0",
    "astro": "^7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
