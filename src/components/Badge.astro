---
/**
 * @file src/components/Badge.astro
 * @description Etiqueta corta de estado o categoría.
 *
 * @deprecated Para pantallas nuevas, usa `@components/ui/badge`. Esta versión
 * sobrevive solo para el chrome sin isla de las pantallas heredadas (`/`,
 * `/agents`, `/history`), que están en la lista de borrado. No añadas
 * consumidores nuevos aquí: dos badges con la misma función es exactamente la
 * duplicación que el registry vino a quitar.
 */
import { cn, variants, type ClassValue } from '@shared/ui/variants';

interface Props {
  tone?: 'neutral' | 'brand' | 'danger' | 'warning';
  class?: ClassValue;
}

const { tone = 'neutral', class: className } = Astro.props;

const badge = variants({
  base: 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-label',
  variants: {
    tone: {
      neutral: 'bg-elevated text-ink-muted',
      brand: 'bg-brand-050 text-brand-600',
      danger: 'bg-danger/10 text-danger',
      warning: 'bg-warning/10 text-ink',
    },
  },
  defaultVariants: { tone: 'neutral' },
});
---

<span class={cn(badge({ tone }), className)}>
  <slot />
</span>
