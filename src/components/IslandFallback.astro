---
/**
 * @file src/components/IslandFallback.astro
 * @description Skeleton reutilizable para el `slot="fallback"` de una isla.
 *
 * Una isla con `client:only` no pinta nada hasta que carga su chunk: sin
 * fallback el usuario ve un salto de layout. Este componente existe para que el
 * placeholder sea el mismo en todas las islas y nadie improvise un gris suelto.
 *
 * Pinta la primitiva `Skeleton` del registry, que en un `.astro` sin directiva
 * se renderiza en el servidor con cero JS (igual que cualquier `.vue` del
 * registry fuera de una isla). Así el pulso y el color del placeholder son los
 * del sistema, no una copia local de `animate-pulse`.
 */
import { Skeleton } from '@components/ui/skeleton';

interface Props {
  /** Cuántas líneas de skeleton. */
  lines?: number;
  /** Altura de bloque contenedor, en clases de Tailwind. */
  height?: string;
}

const { lines = 3, height = 'min-h-40' } = Astro.props;
---

<div class:list={['flex flex-col gap-2 p-4', height]} aria-hidden="true">
  {Array.from({ length: lines }, (_, index) => index).map((index) => (
    <Skeleton class:list={['h-3 rounded', index === lines - 1 ? 'w-2/3' : 'w-full']} />
  ))}
</div>
