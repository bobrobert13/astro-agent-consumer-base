---
/**
 * @file src/components/SideNav.astro
 * @description Navegación lateral. Cero JS: son `<a>` reales, y el router de
 * Astro + View Transitions se encarga del resto.
 */
import Icon from '@components/Icon.astro';
import { routes } from '@config/routes';
import { APP_NAME_LABEL } from '@config/app';

interface Props {
  active?: 'chat' | 'agents' | 'history' | 'settings';
}

const { active = 'chat' } = Astro.props;

const items = [
  { key: 'chat', label: 'Chat', href: routes.chat(), icon: 'chat' },
  { key: 'agents', label: 'Agentes', href: routes.agents(), icon: 'agents' },
  { key: 'history', label: 'Historial', href: routes.history(), icon: 'history' },
  { key: 'settings', label: 'Ajustes', href: routes.settings(), icon: 'settings' },
] as const;
---

<nav
  aria-label="Principal"
  class="flex items-center gap-1 border-b border-line bg-surface px-gutter py-2 md:h-svh md:flex-col md:items-stretch md:border-b-0 md:border-r md:px-2 md:py-4"
>
  <a
    href={routes.home()}
    class="mb-0 hidden items-center gap-2 rounded-panel px-2 py-2 text-title-sm md:mb-4 md:flex"
  >
    <Icon name="spark" class="size-5 text-brand-500" />
    <span class="truncate">{APP_NAME_LABEL}</span>
  </a>

  <ul class="flex flex-1 items-center gap-1 md:flex-1 md:flex-col md:items-stretch md:gap-0.5">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.key === active ? 'page' : undefined}
            class:list={[
              'flex items-center gap-2 rounded-panel px-2.5 py-2 text-body-sm transition-colors',
              'hover:bg-elevated',
              item.key === active
                ? 'bg-brand-050 font-medium text-brand-600'
                : 'text-ink-muted',
            ]}
          >
            <Icon name={item.icon} class="size-4 shrink-0" />
            <span class="hidden md:inline">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <slot name="footer" />
</nav>
