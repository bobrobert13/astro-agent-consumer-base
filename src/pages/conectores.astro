---
/**
 * @file src/pages/conectores.astro
 * @description Vista de conectores: fuentes externas, base de conocimiento y
 * plantillas. Es el destino de "Conecta tus fuentes externas para consultarlas
 * desde el chat".
 *
 * **Es SSR y la home no lo es**, y la diferencia es el estado inicial: aquí la
 * pestaña vive en la URL (`?pestana=`), así que resolverla en el servidor evita
 * abrir siempre en "Conectores" y saltar después. No cuesta nada porque la página
 * no pide datos: todo lo que pinta la isla sale de su semilla.
 *
 * **El estudio se sigue montando debajo**, con su `transition:persist` y con el
 * `hilo`/`agente` que trae la query. La capa se abre también a mitad de
 * conversación —el rail está siempre a la vista—, y sin esas dos props `ChatStudio`
 * recibiría los valores por defecto, cambiaría de hilo y cortaría la respuesta en
 * curso. Es el motivo de que la URL los cargue.
 *
 * La pestaña se valida aquí: una query la escribe cualquiera, y una pestaña que no
 * existe dejaría el panel en blanco sin un error que lo explique.
 */
import AppLayout from '@layouts/AppLayout.astro';
import { ConnectorsView, isConnectorTab } from '@domains/connectors';
import { APP_NAME } from '@shared/env/client';

const params = Astro.url.searchParams;

/**
 * La pestaña se valida aquí y no en la isla: la query es entrada de usuario, y una
 * pestaña que no existe dejaría el panel en blanco sin un error que lo explique.
 * Aguas abajo, el tipo ya es `ConnectorTab`.
 */
const pestana = params.get('pestana') ?? undefined;
const tab = isConnectorTab(pestana) ? pestana : undefined;

const threadId = params.get('hilo') ?? undefined;
const agentId = params.get('agente') ?? undefined;
const volver = params.get('volver') ?? undefined;
---

<AppLayout
  title={APP_NAME}
  description="Conectores, base de conocimiento y plantillas del chat."
  threadId={threadId}
  agentId={agentId}
>
  <!--
    La capa va en el slot `layer` a propósito: `AppLayout` monta primero el
    estudio y después esto, así que la vista queda por encima sin desmontar la
    isla del chat. Sin `transition:persist`: es una pantalla, su estado (filtros,
    búsqueda) no tiene por qué sobrevivir a salir de ella.
  -->
  <ConnectorsView slot="layer" client:only="vue" tab={tab} volver={volver} />
</AppLayout>
