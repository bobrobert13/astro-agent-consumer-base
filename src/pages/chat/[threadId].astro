---
/**
 * @file src/pages/chat/[threadId].astro
 * @description Ruta de conversación. La URL es el contrato: cambiar de hilo es
 * navegar, no emitir un evento ni mutar un store.
 *
 * Monta **la misma isla** que `/` (`transition:persist="chat-studio"`), así que
 * navegar entre las dos rutas no reinicia el estudio: la isla recibe las props
 * nuevas y sigue, que es lo que permite saltar de hilo sin cortar una respuesta
 * en curso. A diferencia de la raíz —que se prerenderiza— aquí sí hay servidor,
 * y por eso el agente activo se resuelve en el servidor y viaja por props.
 *
 * `output: 'server'` hace que esta página se resuelva bajo demanda, que es lo que
 * quiere decir "SPA por defecto con servidor propio".
 */
import StudioLayout from '@layouts/StudioLayout.astro';
import { DEFAULT_AGENT_ID, NEW_THREAD_ID } from '@config/app';

const threadId = Astro.params.threadId ?? NEW_THREAD_ID;
// El agente activo viaja en la URL, no en un store: es lo que hace que un enlace
// a una conversación sea compartible y que "cambiar de agente" sea navegar.
const agentId = Astro.url.searchParams.get('agente') ?? DEFAULT_AGENT_ID;
---

<StudioLayout
  title={threadId === NEW_THREAD_ID ? 'Hilo nuevo' : `Hilo ${threadId}`}
  description="Conversación con el agente."
  threadId={threadId}
  agentId={agentId}
/>
