# ─────────────────────────────────────────────────────────────────────────────
# astro-agent-consumer — copie a `.env` (nunca versione secretos):
#     cp .env.example .env
#
# Etiquetas:
#   [server]  solo llega al proceso Node de Astro; nunca al navegador
#   [public]  se serializa en el bundle del cliente (debe ir con PUBLIC_*)
#   [secret]  credencial: solo server, y jamás aparece en logs ni en el HTML
#
# El contrato de tipos vive en `env.schema` dentro de astro.config.mjs;
# tras cambiarlo, regenere tipos con `npx astro sync`.
# ─────────────────────────────────────────────────────────────────────────────

# [public] 'mock' | 'mastra'. Con 'mock' la app funciona SIN ningún backend.
PUBLIC_AGENT_TRANSPORT=mock

# [public] Nombre visible de la app (título, sidebar, notificaciones).
PUBLIC_APP_NAME=Astro Agent Consumer

# [secret] Dirección del backend de agentes, leída en tiempo de arranque. El
# navegador NUNCA debe ver este host: todo pasa por /api/agent-rpc/*.
# OJO: se declara `access: 'secret'` en el schema aunque no sea una credencial,
# porque con `access: 'public'` Astro inlina el valor en el build y cambiarlo en
# el entorno del proceso no tenía efecto. Misma razón para los timeouts.
MASTRA_URL=http://localhost:4111

# [secret] Solo si el backend exige credencial. Vacío en local.
#MASTRA_API_KEY=

# [secret] Timeout hasta la primera respuesta de bytes del upstream (ms).
AGENT_CONNECT_TIMEOUT=10000

# [secret] Máximo de silencio admitido a mitad de stream antes de marcar `stalled` (ms).
AGENT_IDLE_TIMEOUT=60000

# [server] Host y puerto del servidor standalone. NO son `envField`: los lee
# directamente `dist/server/entry.mjs` (documentado en la guía de @astrojs/node).
HOST=127.0.0.1
PORT=4321
