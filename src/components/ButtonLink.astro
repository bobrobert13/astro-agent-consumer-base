---
/**
 * @file src/components/ButtonLink.astro
 * @description Enlace con pinta de botón. Es un `<a>` de verdad: navega sin JS y
 * `ClientRouter` lo intercala como transición.
 */
import { cn, variants, type ClassValue } from '@shared/ui/variants';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'danger';
  size?: 'sm' | 'md';
  class?: ClassValue;
  external?: boolean;
}

const { href, variant = 'secondary', size = 'md', class: className, external = false } = Astro.props;

const button = variants({
  base: 'inline-flex items-center justify-center gap-1.5 rounded-panel font-medium transition-colors focus-visible:outline-2',
  variants: {
    variant: {
      primary: 'bg-brand-500 text-on-brand hover:bg-brand-600',
      secondary: 'border border-line bg-surface text-ink hover:bg-elevated',
      ghost: 'text-ink-muted hover:bg-elevated hover:text-ink',
      danger: 'border border-danger bg-surface text-danger hover:bg-elevated',
    },
    size: {
      sm: 'h-8 px-2.5 text-label',
      md: 'h-9 px-3.5 text-body-sm',
    },
  },
  defaultVariants: { variant: 'secondary', size: 'md' },
});
---

<a
  href={href}
  class={cn(button({ variant, size }), className)}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>
