---
/**
 * @file src/pages/index.astro
 * @description Raíz del producto: el estudio de chat a pantalla completa.
 *
 * `prerender = true` se mantiene a propósito: esta página no depende de datos
 * por-request, así que se consolida en `dist/client` y es el sitio donde el
 * boilerplate demuestra el modo mixto de Astro 7 (`output: 'server'` con una
 * página estática). Como consecuencia, el `?agente=` de la URL **no** se puede
 * leer aquí en el servidor; el estudio lo resuelve en el cliente al montar. La
 * ruta `/chat/<hilo>`, que sí es SSR, lo lee en el servidor.
 */
import StudioLayout from '@layouts/StudioLayout.astro';
import { APP_NAME } from '@shared/env/client';

export const prerender = true;
---

<StudioLayout title={APP_NAME} description="Estudio de chat sobre agentes de IA." />
