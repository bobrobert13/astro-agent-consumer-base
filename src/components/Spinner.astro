---
/**
 * @file src/components/Spinner.astro
 * @description Indicador de actividad. Respeta `prefers-reduced-motion` (ya que
 * la capa base anula las duraciones), así que aquí solo se pinta la rotación.
 */
interface Props {
  label?: string;
}

const { label = 'Cargando' } = Astro.props;
---

<span role="status" class="inline-flex items-center gap-2 text-caption text-ink-muted">
  <span
    class="size-3.5 animate-spin rounded-full border-2 border-line border-t-brand-500"
    aria-hidden="true"
  >
  </span>
  <span class="sr-only">{label}</span>
</span>
