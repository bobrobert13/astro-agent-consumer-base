---
/**
 * @file src/components/PanelHeader.astro
 * @description Cabecera de un `Panel`: título + descripción + acciones a la derecha.
 */
interface Props {
  title: string;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<header class="flex items-start gap-3 border-b border-line pb-3">
  <div class="min-w-0 flex-1">
    <h2 class="truncate text-title-sm">{title}</h2>
    {description !== undefined && description !== '' && (
      <p class="mt-0.5 text-caption text-ink-muted">{description}</p>
    )}
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <slot name="actions" />
  </div>
</header>
