---
/**
 * @file src/pages/agents/[agentId].astro
 * @description Ficha de un agente: lo que el BFF deja ver, y nada más.
 *
 * Las instrucciones completas del agente **no** viajan: el recorte ocurre en
 * `agent-registry/server/list-agents.ts`. Si alguien añade un campo nuevo al
 * DTO, que decida conscientemente que es público.
 */
import BareLayout from '@layouts/BareLayout.astro';
import Panel from '@components/Panel.astro';
import PanelHeader from '@components/PanelHeader.astro';
import Badge from '@components/Badge.astro';
import ButtonLink from '@components/ButtonLink.astro';
import EmptyState from '@components/EmptyState.astro';
import Icon from '@components/Icon.astro';
import { getAgent } from '@domains/agent-registry/server';
import { routes } from '@config/routes';

const agentId = Astro.params.agentId ?? '';
const result = await getAgent(agentId);
const agent = result.ok ? result.data : undefined;
---

<BareLayout title={agent?.name ?? 'Agente'}>
  {agent === undefined ? (
    <EmptyState title="Agente no encontrado" description="Puede que el backend haya cambiado de catálogo." icon="error">
      <ButtonLink href={routes.agents()}>Volver al catálogo</ButtonLink>
    </EmptyState>
  ) : (
    <Panel pad="none">
      <PanelHeader title={agent.name} description={agent.description}>
        <template slot="actions">
          <Badge tone="brand">
            <Icon name="spark" />
            {agent.id}
          </Badge>
        </template>
      </PanelHeader>

      <div class="flex flex-col gap-4 p-4">
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-ink-muted">Herramientas declaradas</p>
          {agent.tools.length === 0 ? (
            <p class="mt-1 text-sm text-ink-muted">Ninguna declarada en el catálogo.</p>
          ) : (
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {agent.tools.map((tool) => (
                <li>
                  <Badge>
                    <code class="font-mono">{tool}</code>
                  </Badge>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="flex gap-2">
          <ButtonLink href={`${routes.chat()}?agente=${encodeURIComponent(agent.id)}`} variant="primary">
            <Icon name="chat" />
            Conversar con este agente
          </ButtonLink>
          <ButtonLink href={routes.agents()} variant="ghost">Atrás</ButtonLink>
        </div>
      </div>
    </Panel>
  )}
</BareLayout>
