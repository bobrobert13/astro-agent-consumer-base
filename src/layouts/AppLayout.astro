---
/**
 * @file src/layouts/AppLayout.astro
 * @description Layout del producto: el documento y la isla que compone toda la
 * pantalla.
 *
 * No hay chrome `.astro` aquí, y es una decisión, no un olvido. La política de
 * hidratación del repositorio pide chrome sin directiva cuando es estático, pero
 * esta pantalla **no tiene chrome estático**: rail, cajón, menús, panel de
 * contexto y modal comparten estado, y el hilo del agente tiene que sobrevivir a
 * la navegación. Partirlo en islas hermanas obligaría a manipular desde fuera un
 * DOM ajeno, así que el estudio entero es una isla (`client:only` +
 * `transition:persist`) y el hueco previo a la hidratación lo cubre el fallback.
 *
 * Sustituye al `AppLayout` del shell anterior (chrome `.astro` + islas hermanas),
 * que se retiró con las pantallas heredadas.
 *
 * **`layer` es el slot de las capas de pantalla completa.** Existe para que una
 * vista como la de conectores se pinte *encima* del estudio sin desmontarlo: se
 * renderiza después de `ChatStudio`, así que su `fixed inset-0` la deja delante y
 * el hilo —incluso a mitad de respuesta— sobrevive. Montarla en un layout aparte
 * habría duplicado el punto de montaje del estudio, que es justo donde se
 * sincronizan el hilo y el agente de la URL.
 */
import RootLayout from './RootLayout.astro';
import IslandFallback from '@components/IslandFallback.astro';
import { NavigationProgress } from '@domains/app-shell';
import { ChatStudio } from '@domains/chat-studio';
import { DEFAULT_AGENT_ID, NEW_THREAD_ID } from '@config/app';

interface Props {
  title: string;
  description?: string | undefined;
  /** Hilo activo; viaja en el segmento de ruta de `/chat/…`. */
  threadId?: string | undefined;
  /** Agente activo; viaja en `?agente=`. */
  agentId?: string | undefined;
}

const { title, description, threadId = NEW_THREAD_ID, agentId = DEFAULT_AGENT_ID } = Astro.props;
---

<RootLayout title={title} description={description}>
  <!--
    Con `transition:persist`: la barra tiene que ser **la misma** instancia en
    todas las rutas. Si se remontara en cada navegación, llegaría tarde a su suyo
    —el evento que la arranca ya habría pasado— y nunca se vería.
  -->
  <NavigationProgress client:only="vue" transition:persist="nav-progress" />

  <!--
    El estudio se persiste con nombre propio para que navegar entre `/` y
    `/chat/<hilo>` no reinicie el stream: la isla recibe las props nuevas y sigue.
  -->
  <ChatStudio
    client:only="vue"
    transition:persist="chat-studio"
    thread-id={threadId}
    agent-id={agentId}
  >
    <IslandFallback slot="fallback" lines={6} height="h-svh" />
  </ChatStudio>

  <!--
    Capas a pantalla completa (hoy, la vista de conectores). Van aquí y no dentro
    del estudio: así se pintan encima del chat sin obligarlo a desmontarse.
  -->
  <slot name="layer" />
</RootLayout>
