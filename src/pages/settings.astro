---
/**
 * @file src/pages/settings.astro
 * @description Ajustes: estado del entorno, atajos y tokens de la interfaz.
 *
 * Muestra configuración **pública por diseño**. Lo que es secreto o del servidor
 * (host del backend, credenciales, timeouts) se menciona como existente pero no se
 * imprime: una página renderizada en el servidor termina en el HTML del
 * navegador, y ahí ya no hay distinción entre "interior" y "público".
 */
import AppLayout from '@layouts/AppLayout.astro';
import PageTitle from '@components/PageTitle.astro';
import Panel from '@components/Panel.astro';
import PanelHeader from '@components/PanelHeader.astro';
import KeyHint from '@components/KeyHint.astro';
import Badge from '@components/Badge.astro';
import { APP_NAME_LABEL, APP_VERSION } from '@config/app';
import { AGENT_TRANSPORT } from '@shared/env/client';
import { SHORTCUTS, DURATIONS } from '@config/ui/tokens';
import { routes } from '@config/routes';

const shortcuts = [
  { combo: SHORTCUTS.newThread, label: 'Hilo nuevo' },
  { combo: SHORTCUTS.preferences, label: 'Preferencias' },
  { combo: SHORTCUTS.toggleSidebar, label: 'Mostrar/ocultar navegación' },
  { combo: SHORTCUTS.stopStream, label: 'Detener la respuesta en curso' },
];

const facts = [
  { label: 'Transporte de agentes', value: AGENT_TRANSPORT },
  { label: 'Versión', value: APP_VERSION },
  { label: 'Duración de transición base', value: `${DURATIONS.base} ms` },
  { label: 'Backend del proveedor', value: 'oculto a propósito (MASTRA_URL es server-only)' },
];
---

<AppLayout title="Ajustes" active="settings">
  <div class="mx-auto h-full max-w-3xl overflow-y-auto px-6 py-8">
    <PageTitle title={APP_NAME_LABEL} description="Lo que el boilerplate deja visible y editable sin recompilar." />

    <div class="grid gap-3 sm:grid-cols-2">
      <Panel pad="none">
        <PanelHeader title="Entorno" description="Valores públicos del runtime." />
        <dl class="flex flex-col gap-2 p-4 text-sm">
          {facts.map((fact) => (
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-ink-muted">{fact.label}</dt>
              <dd class="text-right font-mono text-xs">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </Panel>

      <Panel pad="none">
        <PanelHeader title="Atajos" description="Registrados por useShortcuts() y la isla de chat, no por el menú nativo." />
        <ul class="flex flex-col gap-2 p-4 text-sm">
          {shortcuts.map((shortcut) => (
            <li class="flex items-center justify-between gap-3">
              <span class="text-ink-muted">{shortcut.label}</span>
              <KeyHint combo={shortcut.combo} />
            </li>
          ))}
        </ul>
      </Panel>
    </div>

    <div class="mt-6 flex items-center gap-2">
      <Badge tone={AGENT_TRANSPORT === 'mock' ? 'neutral' : 'brand'}>
        transporte {AGENT_TRANSPORT}
      </Badge>
      <a href={routes.chat()} class="text-xs underline hover:no-underline">Volver al chat</a>
    </div>
  </div>
</AppLayout>
