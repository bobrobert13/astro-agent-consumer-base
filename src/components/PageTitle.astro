---
/**
 * @file src/components/PageTitle.astro
 * @description Título de página dentro de un `main`. `TopBar` ya muestra el
 * título visual; este es el `h1` semántico del documento.
 */
interface Props {
  title: string;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<div class="mb-block">
  <h1 class="text-title">{title}</h1>
  {description !== undefined && description !== '' && (
    <p class="mt-1 text-lede text-ink-muted">{description}</p>
  )}
</div>
