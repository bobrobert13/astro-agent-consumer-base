---
/**
 * @file src/layouts/AppLayout.astro
 * @description Layout de producto: shell + título + slots de contenido.
 *
 * Deliberadamente **no** monta islas de contenido: la isla vive en la página que
 * la necesita, porque es la página quien conoce los `params`. La única excepción
 * es `ShellShortcuts` (sin UI, `client:only`): los atajos globales que /settings
 * anuncia deben existir en todas las páginas del shell, y montarlos página a
 * página los duplicaría. Lo que sí garantiza este layout es que el contenedor
 * (`main`) tenga altura contenida y `min-w-0`, que es el prerequisito de
 * cualquier transcript con scroll.
 */
import RootLayout from './RootLayout.astro';
import AppShell from '@components/AppShell.astro';
import { NavigationProgress, ShellShortcuts } from '@domains/app-shell';

interface Props {
  title: string;
  description?: string | undefined;
  active?: 'chat' | 'agents' | 'history' | 'settings';
  subtitle?: string | undefined;
}

const { title, description, active = 'chat', subtitle } = Astro.props;
---

<RootLayout title={title} description={description}>
  <ShellShortcuts client:only="vue" />
  <!--
    Con `transition:persist`: la barra tiene que ser **la misma** instancia en
    todas las rutas. Si se remontara en cada navegación, llegaría tarde a la suya
    —el evento que la arranca ya habría pasado— y nunca se vería.
  -->
  <NavigationProgress client:only="vue" transition:persist="nav-progress" />

  <AppShell {active} {title} {subtitle}>
    <!--
      Envoltor con `contents` para no alterar la rejilla del TopBar: Astro
      proyecta el contenido por el atributo `slot`, y este patrón funciona igual
      con o sin reenvío de slots entre componentes.
    -->
    <div slot="actions" class="contents">
      <slot name="actions" />
    </div>
    <slot />
  </AppShell>
</RootLayout>
