---
/**
 * @file src/components/AppShell.astro
 * @description Rejilla del shell de aplicación: barra superior, nav lateral, área
 * de trabajo. Presentacional y **sin JS**: el estado de abierto/cerrado del
 * sidebar vive en `app-shell` (isla o CSS puro), no aquí.
 *
 * `compressHTML: 'jsx'` en Astro 7 elimina el whitespace entre hermanos inline.
 * En un contenedor de grid no molesta, pero si se añade un `<span>` inline aquí
 * hay que separarlo explícitamente con `{" "}`.
 */
import SideNav from '@components/SideNav.astro';
import TopBar from '@components/TopBar.astro';

interface Props {
  active?: 'chat' | 'agents' | 'history' | 'settings';
  title: string;
  subtitle?: string | undefined;
}

const { active = 'chat', title, subtitle } = Astro.props;
---

<div class="aac-shell">
  <SideNav {active} />

  <div class="contents max-md:*:block md:grid md:grid-rows-[auto_1fr] md:min-w-0">
    <TopBar {title} {subtitle}>
      <slot name="actions" />
    </TopBar>

    <main class="min-h-0 min-w-0 overflow-hidden">
      <slot />
    </main>
  </div>
</div>
