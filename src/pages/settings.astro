---
/**
 * @file src/pages/settings.astro
 * @description Ajustes, en cuatro secciones con dos niveles de dinamismo.
 *
 * Lo que necesita cliente son dos islas (`AppearanceCard`, `AgentConfigCard`); lo
 * que no se renderiza en el servidor con cero JS: el catálogo de atajos y el
 * estado del entorno. La lista de agentes **y la config del agente activo** las
 * resuelve esta página en el servidor y viajan como props: así `agent-config` no
 * depende de `agent-registry`, y el formulario llega habilitado en el HTML en vez
 * de esperar a hidratar y a que vuelva un `GET`.
 *
 * Las islas van con `client:visible`: hidratan cuando la tarjeta está en pantalla,
 * y como la config viaja resuelta en el HTML no hay nada que ganar adelantando la
 * hidratación. Se probó `client:idle` para eso y **no vale**: `requestIdleCallback`
 * se difiere mientras la página no está visible, así que en una ventana en segundo
 * plano las islas no hidrataban nunca (el `Select` no llegaba a abrirse; lo cazó
 * `verify:electron`).
 *
 * No se imprime nada secreto: el host del backend y las credenciales son
 * server-only, y una página terminaría enviándolos al navegador.
 */
import AppLayout from '@layouts/AppLayout.astro';
import { AppearanceCard } from '@domains/app-shell';
import { AgentConfigCard } from '@domains/agent-config';
import { readAgentConfig } from '@domains/agent-config/server';
import { listAgents } from '@domains/agent-registry/server';
import { Alert, AlertDescription, AlertTitle } from '@components/ui/alert';
import { Badge } from '@components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@components/ui/card';
import { Kbd, KbdGroup } from '@components/ui/kbd';
import { Separator } from '@components/ui/separator';
import { Info } from '@lucide/vue';
import { APP_NAME_LABEL, APP_VERSION } from '@config/app';
import { AGENT_TRANSPORT } from '@shared/env/client';
import { SHORTCUTS, STORAGE_KEYS } from '@config/ui/tokens';

/**
 * Cuánto puede esperar el render a la config del agente.
 *
 * Resolverla aquí ahorra el viaje de ida y vuelta al hidratar, pero no a costa del
 * TTFB: si el backend tarda más que esto, la página sale igual (con el formulario
 * pidiéndola desde el cliente, como antes) en vez de quedarse colgada hasta el
 * timeout de conexión del relay, que son 10 s.
 */
const CONFIG_RENDER_BUDGET_MS = 1_200;

const sections = [
  { id: 'apariencia', label: 'Apariencia' },
  { id: 'agente', label: 'Agente y ejecución' },
  { id: 'atajos', label: 'Atajos' },
  { id: 'entorno', label: 'Entorno' },
];

const shortcuts = [
  { combo: SHORTCUTS.newThread, label: 'Hilo nuevo' },
  { combo: SHORTCUTS.preferences, label: 'Ir a ajustes' },
  { combo: SHORTCUTS.toggleSidebar, label: 'Mostrar u ocultar la navegación' },
  { combo: SHORTCUTS.stopStream, label: 'Detener la respuesta en curso' },
];

/** `mod` es Cmd en macOS y Ctrl elsewhere: se pinta el literal neutro del teclado. */
function prettyCombo(combo: string): string[] {
  return combo.split('+').map((part) => (part === 'mod' ? 'Ctrl' : part === 'comma' ? ',' : part.toUpperCase()));
}

const agentsResult = await listAgents();
const agents = agentsResult.ok ? agentsResult.data : [];
const catalogUnavailable = !agentsResult.ok || agents.length === 0;

const initialAgentId = agents[0]?.id ?? 'research-agent';
// Se lee siempre, también cuando el catálogo no respondió: este lector no falla
// por el backend ausente, devuelve los valores por defecto (es lo que hace que una
// config no disponible no bloquee el chat). Saltárselo "para ahorrar un viaje"
// dejaba el formulario deshabilitado justo en el caso más común —sin backend—,
// que es el retardo que se venía a quitar.
const configResult = await readAgentConfig(initialAgentId, { signal: AbortSignal.timeout(CONFIG_RENDER_BUDGET_MS) });
const initialSettings = configResult.ok ? configResult.data : undefined;

const facts = [
  { label: 'Transporte de agentes', value: AGENT_TRANSPORT },
  { label: 'Versión', value: APP_VERSION },
  { label: 'Preferencias en', value: `localStorage (${STORAGE_KEYS.theme}, ${STORAGE_KEYS.sidebarOpen})` },
  { label: 'Backend del proveedor', value: 'oculto a propósito: es server-only' },
];
---

<AppLayout title="Ajustes" active="settings" description="Apariencia, perillas del agente y estado del entorno.">
  <div class="h-full overflow-y-auto">
    <div class="mx-auto grid max-w-5xl gap-6 px-6 py-8 lg:grid-cols-[12rem_1fr]">
      <nav aria-label="Secciones" class="hidden lg:block">
        <div class="sticky top-6 flex flex-col gap-1">
          {sections.map((section) => (
            <a
              href={`#${section.id}`}
              class="rounded-md px-2 py-1.5 text-sm text-muted-foreground hover:bg-accent hover:text-foreground"
            >
              {section.label}
            </a>
          ))}
        </div>
      </nav>

      <div class="flex min-w-0 flex-col gap-6">
        <div>
          <h1 class="text-xl font-semibold tracking-tight">{APP_NAME_LABEL}</h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Lo que se puede cambiar sin recompilar. Las preferencias de interfaz viven en este
            dispositivo; las del agente se envían al backend.
          </p>
        </div>

        <section id="apariencia" class="scroll-mt-6">
          <AppearanceCard client:visible />
        </section>

        <section id="agente" class="scroll-mt-6">
          <!--
            Props en camelCase, como `agents`: Astro serializa este objeto tal cual
            en el `props` de la isla, así que escribirlas en kebab dependería de
            que Vue camelice claves que aquí llegan como datos, no como atributos.
          -->
          <AgentConfigCard
            client:visible
            agents={agents}
            initialAgentId={initialAgentId}
            initialSettings={initialSettings}
          />
        </section>

        <section id="atajos" class="scroll-mt-6">
          <Card>
            <CardHeader>
              <CardTitle>Atajos</CardTitle>
              <CardDescription>
                Los registran <code class="font-mono text-xs">ShellShortcuts</code> en el shell y la
                propia isla de chat, no el menú nativo — que en escritorio declara los mismos.
              </CardDescription>
            </CardHeader>
            <CardContent class="flex flex-col gap-3">
              {shortcuts.map((shortcut) => (
                <div class="flex items-center justify-between gap-4">
                  <span class="text-sm text-muted-foreground">{shortcut.label}</span>
                  <KbdGroup>
                    {prettyCombo(shortcut.combo).map((key) => (<Kbd>{key}</Kbd>))}
                  </KbdGroup>
                </div>
              ))}
              <p class="text-xs text-muted-foreground">
                En macOS, <code class="font-mono">Ctrl</code> equivale a <code class="font-mono">Cmd</code>.
              </p>
            </CardContent>
          </Card>
        </section>

        <section id="entorno" class="scroll-mt-6">
          <Card>
            <CardHeader>
              <CardTitle>Entorno</CardTitle>
              <CardDescription>Valores públicos del runtime, leídos en el servidor.</CardDescription>
            </CardHeader>
            <CardContent class="flex flex-col gap-4">
              <dl class="flex flex-col gap-2">
                {facts.map((fact) => (
                  <div class="flex items-baseline justify-between gap-4">
                    <dt class="text-sm text-muted-foreground">{fact.label}</dt>
                    <dd class="text-right font-mono text-xs">{fact.value}</dd>
                  </div>
                ))}
              </dl>

              <Separator />

              {catalogUnavailable ? (
                <Alert>
                  <Info />
                  <AlertTitle>Sin catálogo de agentes</AlertTitle>
                  <AlertDescription>
                    El backend no respondió a <code class="font-mono text-xs">GET /api/agents</code>. Con
                    <code class="font-mono text-xs"> PUBLIC_AGENT_TRANSPORT=mock</code> el chat funciona igual sin
                    levantar nada; para ver agentes reales arranca el servidor y apunta
                    <code class="font-mono text-xs"> MASTRA_URL</code>.
                  </AlertDescription>
                </Alert>
              ) : (
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="text-sm text-muted-foreground">Agentes alcanzables:</span>
                  {agents.map((agent) => (<Badge variant="secondary">{agent.name}</Badge>))}
                </div>
              )}
            </CardContent>
          </Card>
        </section>
      </div>
    </div>
  </div>
</AppLayout>
